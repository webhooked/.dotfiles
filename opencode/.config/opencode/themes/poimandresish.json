{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkYellow": "#FFFAC2",
    "darkTeal1": "#5DE4C7",
    "darkTeal2": "#5FB3A1",
    "darkBlue1": "#89DDFF",
    "darkBlue2": "#ADD7FF",
    "darkBlue3": "#91B4D5",
    "darkPink2": "#FCC5E9",
    "darkPink3": "#D0679D",
    "darkBlueGray1": "#A6ACCD",
    "darkBlueGray2": "#8389A6",
    "darkBlueGray3": "#506477",
    "darkBackground": "#1B1E28",
    "darkPanel": "#212631",
    "darkElement": "#303340",
    "darkBorderSubtle": "#232834",
    "darkText": "#E4F0FB",
    "darkWhite": "#FFFFFF",

    "lightYellow": "#7D5F00",
    "lightTeal1": "#00755F",
    "lightTeal2": "#3A7368",
    "lightBlue1": "#06699A",
    "lightBlue2": "#3765A8",
    "lightBlue3": "#4D6986",
    "lightPink2": "#A34483",
    "lightPink3": "#B5366D",
    "lightBlueGray1": "#4E5573",
    "lightBlueGray2": "#646A85",
    "lightBlueGray3": "#8F9AAB",
    "lightBackground": "#F4F6FA",
    "lightPanel": "#E8EBF1",
    "lightElement": "#E4E9F0",
    "lightBorder": "#D6DCE6",
    "lightBorderSubtle": "#E5E8EE",
    "lightText": "#272C3B",
    "lightWhite": "#141824"
  },
  "theme": {
    "primary": { "dark": "darkTeal1", "light": "lightTeal1" },
    "secondary": { "dark": "darkBlue2", "light": "lightBlue2" },
    "accent": { "dark": "darkPink2", "light": "lightPink2" },
    "error": { "dark": "darkPink3", "light": "lightPink3" },
    "warning": { "dark": "darkYellow", "light": "lightYellow" },
    "success": { "dark": "darkTeal1", "light": "lightTeal1" },
    "info": { "dark": "darkBlue1", "light": "lightBlue1" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkBlueGray2", "light": "lightBlueGray2" },
    "selectedListItemText": { "dark": "darkBackground", "light": "lightBackground" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "backgroundMenu": { "dark": "darkPanel", "light": "lightPanel" },
    "border": { "dark": "darkElement", "light": "lightBorder" },
    "borderActive": { "dark": "darkBlueGray3", "light": "lightBlueGray3" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "darkTeal1", "light": "lightTeal1" },
    "diffRemoved": { "dark": "darkPink3", "light": "lightPink3" },
    "diffContext": { "dark": "darkBlueGray2", "light": "lightBlueGray2" },
    "diffHunkHeader": { "dark": "darkBlue3", "light": "lightBlue3" },
    "diffHighlightAdded": { "dark": "darkTeal1", "light": "lightTeal1" },
    "diffHighlightRemoved": { "dark": "darkPink3", "light": "lightPink3" },
    "diffAddedBg": { "dark": "#253C40", "light": "#CFE3E3" },
    "diffRemovedBg": { "dark": "#36293A", "light": "#EBD9E5" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkBlueGray3", "light": "lightBlueGray3" },
    "diffAddedLineNumberBg": { "dark": "#202E35", "light": "#E0ECEE" },
    "diffRemovedLineNumberBg": { "dark": "#292431", "light": "#EFE7EF" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkTeal2", "light": "lightTeal2" },
    "markdownLink": { "dark": "darkBlue3", "light": "lightBlue3" },
    "markdownLinkText": { "dark": "darkBlue1", "light": "lightBlue1" },
    "markdownCode": { "dark": "darkTeal2", "light": "lightTeal2" },
    "markdownBlockQuote": { "dark": "darkBlueGray2", "light": "lightBlueGray2" },
    "markdownEmph": { "dark": "darkBlueGray1", "light": "lightBlueGray1" },
    "markdownStrong": { "dark": "darkWhite", "light": "lightWhite" },
    "markdownHorizontalRule": { "dark": "darkBlueGray3", "light": "lightBlueGray3" },
    "markdownListItem": { "dark": "darkBlue3", "light": "lightBlue3" },
    "markdownListEnumeration": { "dark": "darkBlue3", "light": "lightBlue3" },
    "markdownImage": { "dark": "darkBlue3", "light": "lightBlue3" },
    "markdownImageText": { "dark": "darkBlue1", "light": "lightBlue1" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkBlueGray2", "light": "lightBlueGray2" },
    "syntaxKeyword": { "dark": "darkBlue3", "light": "lightBlue3" },
    "syntaxFunction": { "dark": "darkYellow", "light": "lightYellow" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "darkTeal1", "light": "lightTeal1" },
    "syntaxNumber": { "dark": "darkTeal1", "light": "lightTeal1" },
    "syntaxType": { "dark": "darkBlueGray1", "light": "lightBlueGray1" },
    "syntaxOperator": { "dark": "darkBlue2", "light": "lightBlue2" },
    "syntaxPunctuation": { "dark": "darkBlue3", "light": "lightBlue3" }
  }
}
