// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "context_servers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse"],
      "env": {}
    }
  },
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking"
    },
    "dock": "left"
  },
  "ui_font_size": 13,
  "ui_font_family": "SF Pro Text",
  "buffer_font_size": 13,
  "buffer_font_family": "Berkeley Mono Variable",
  "buffer_line_height": { "custom": 1.6 },
  "buffer_font_features": {
    "ligatures": true
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "Berkeley Mono Variable",
    "font_size": 12
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "vertical_scroll_margin": 999,
  "theme": {
    "mode": "dark",
    "dark": "Polar",
    "light": "Polar"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "never"
  },
  "vim": {
    "use_system_clipboard": "always"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "diagnostics": { "inline": { "enabled": true } },
  "confirm_quit": true,
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": false
  },
  "journal": {
    "path": "~",
    "hour_format": "hour24"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "notification_panel": {
    "button": true
  },
  "gutter": {
    "folds": false
  },
  "minimap": { "show": "always" }
  // "tab_bar": {
  //   "show": false
  // }
  // "colorize_brackets": true
}
