{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx gitnexus:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm -rf:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(exec:*)",
      "Bash(eval:*)",
      "Bash(source:*)",
      "Bash(.:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Bash(ncat:*)",
      "Bash(perl:*)",
      "Bash(ruby:*)",
      "Bash(node:*)",
      "Bash(php:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(pg_dumpall:*)",
      "Bash(createdb:*)",
      "Bash(dropdb:*)",
      "Bash(createuser:*)",
      "Bash(dropuser:*)",
      "Bash(pgcli:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "Bash(mysqlimport:*)",
      "Bash(mysqladmin:*)",
      "Bash(mariadb:*)",
      "Bash(mariadb-dump:*)",
      "Bash(mycli:*)",
      "Bash(sqlite3:*)",
      "Bash(litecli:*)",
      "Bash(mongo:*)",
      "Bash(mongosh:*)",
      "Bash(mongodump:*)",
      "Bash(mongorestore:*)",
      "Bash(redis-cli:*)",
      "Bash(sqlcmd:*)",
      "Bash(bcp:*)",
      "Bash(cqlsh:*)",
      "Bash(influx:*)",
      "Bash(cockroach:*)",
      "Bash(clickhouse-client:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(git push:*)",
      "Bash(git subtree push:*)",
      "Bash(git lfs push:*)",
      "Bash(git svn dcommit:*)",
      "Bash(git send-email:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --merge:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -f:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune=now:*)",
      "Bash(git prune:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Read(**.env)",
      "Read(**.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_tool_use.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/damage-control/bash-tool-damage-control.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/damage-control/edit-tool-damage-control.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/damage-control/write-tool-damage-control.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f tsconfig.json ]; then bunx tsc --noEmit 2>&1 | head -20; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/user_prompts_submit.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); clock=$(date '+%H:%M:%S'); hostname=$(hostname -s); model=$(echo \"$input\" | jq -r '.model.display_name'); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); folder=$(basename \"$current_dir\"); if git -C \"$current_dir\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$current_dir\" branch --show-current 2>/dev/null || echo 'detached'); git_info=\" 🌳 $branch\"; else git_info=''; fi; printf \"🕒 %s 💻 %s 🤖 %s 📁 %s%s 📍 %s\" \"$clock\" \"$hostname\" \"$model\" \"$folder\" \"$git_info\" \"$current_dir\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "code-simplifier@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "i-have-adhd@i-have-adhd": true,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "todoist@doist": true,
    "stripe@claude-plugins-official": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "code-review@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "upstash@upstash": true,
    "xcode@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "doist": {
      "source": {
        "source": "github",
        "repo": "doist/todoist-mcp"
      }
    },
    "upstash": {
      "source": {
        "source": "github",
        "repo": "upstash/skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable here (no git remotes configured for this repo) — assume private unless later shown otherwise",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Not queryable here (no remotes, default branch unknown)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo only (no remotes configured, no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: backend/.env, backend/internal/secret/secret.go, backend/internal/secret/secret_test.go — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /Users/webhooked/repos/takt (no remotes configured)",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
