# Codex execpolicy rules — stowed to ~/.codex/rules/dotfiles.rules
# Ported from the Claude `permissions.deny` list.
# Codex appends "always allow" approvals to default.rules (gitignored), not here.
# Check a command: codex execpolicy check --rules ~/.codex/rules/dotfiles.rules git push
#
# Shell wrappers (sh/bash/zsh) are intentionally not forbidden here: Codex runs
# commands via `zsh -lc`, so a prefix rule on them can catch the wrapper itself.
# The pre_tool_use hook still blocks them.

# --- Destructive filesystem -------------------------------------------------
prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-rF", "-fR"]],
    decision = "forbidden",
    justification = "Recursive force delete is blocked. Delete specific files instead.",
    match = ["rm -rf build"],
    not_match = ["rm file.txt"],
)
prefix_rule(pattern = [["sudo", "su"]], decision = "forbidden", justification = "No privilege escalation.")
prefix_rule(pattern = [["mkfs", "dd"]], decision = "forbidden", justification = "Disk-level tools are blocked.")

# --- Arbitrary code execution / network -------------------------------------
prefix_rule(
    pattern = [["exec", "eval", "source", "."]],
    decision = "forbidden",
    justification = "Indirect execution is blocked.",
)
prefix_rule(
    pattern = [["curl", "wget", "nc", "netcat", "ncat"]],
    decision = "forbidden",
    justification = "Network tools are blocked. Ask the user to fetch it, or use an MCP/web tool.",
)
prefix_rule(
    pattern = [["perl", "ruby", "node", "php", "go", "make"]],
    decision = "forbidden",
    justification = "Interpreters/build runners are blocked; ask the user to run it.",
)

# --- Databases --------------------------------------------------------------
prefix_rule(
    pattern = [[
        "psql", "pg_dump", "pg_restore", "pg_dumpall", "createdb", "dropdb",
        "createuser", "dropuser", "pgcli",
        "mysql", "mysqldump", "mysqlimport", "mysqladmin", "mariadb", "mariadb-dump", "mycli",
        "sqlite3", "litecli",
        "mongo", "mongosh", "mongodump", "mongorestore",
        "redis-cli", "sqlcmd", "bcp", "cqlsh", "influx", "cockroach", "clickhouse-client",
    ]],
    decision = "forbidden",
    justification = "Database CLIs are blocked to protect real data.",
)

# --- Git: pushing and destructive commands only -----------------------------
# Everything else (fetch, pull, merge, rebase, checkout <branch>, stash, clone,
# ...) is allowed. Prefix rules can't see flags in arbitrary positions, so the
# full check lives in ~/.claude/hooks/pre_tool_use.py (is_blocked_git_command),
# which Codex also runs; these rules are the fast, obvious cases.
prefix_rule(
    pattern = ["git", ["push", "send-email", "filter-branch", "filter-repo", "prune"]],
    decision = "forbidden",
    justification = "Pushing and history-destroying git commands are blocked; ask the user to run it.",
    match = ["git push origin main", "git filter-branch --tree-filter x"],
    not_match = ["git status", "git commit -m msg", "git pull", "git fetch"],
)
prefix_rule(pattern = ["git", ["subtree", "lfs"], "push"], decision = "forbidden", justification = "Pushing is blocked.")
prefix_rule(pattern = ["git", "svn", "dcommit"], decision = "forbidden", justification = "Pushing is blocked.")
prefix_rule(
    pattern = ["git", "reset", ["--hard", "--merge"]],
    decision = "forbidden",
    justification = "Discards uncommitted changes; use --soft or stash.",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1", "git reset HEAD file"],
)
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "git clean deletes untracked files.")
prefix_rule(pattern = ["git", "checkout", ["--", ".", "-f", "--force", "-B"]], decision = "forbidden", justification = "Discards uncommitted changes.")
prefix_rule(pattern = ["git", "restore", "."], decision = "forbidden", justification = "Discards uncommitted changes; use --staged to unstage.")
prefix_rule(pattern = ["git", "switch", ["--discard-changes", "-f", "--force", "-C"]], decision = "forbidden", justification = "Discards uncommitted changes.")
prefix_rule(pattern = ["git", "stash", ["drop", "clear"]], decision = "forbidden", justification = "Deletes stashes.")
prefix_rule(pattern = ["git", "branch", ["-D", "-M", "-f", "--force"]], decision = "forbidden", justification = "Can lose unmerged commits; use -d.")
prefix_rule(pattern = ["git", "reflog", ["expire", "delete"]], decision = "forbidden", justification = "Destroys recovery data.")
